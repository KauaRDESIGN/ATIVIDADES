programa
{
	
	funcao inicio()
	{

	   real base
        real altura
        real area

        escreva("Digite a base: ")
        leia(base)

        escreva("Digite a altura: ")
        leia(altura)

        area = base * altura

        escreva("Área do retângulo: ", area)
        
	}
}
