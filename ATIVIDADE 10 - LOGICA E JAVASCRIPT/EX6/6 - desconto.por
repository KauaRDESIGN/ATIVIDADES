programa
{
	
	funcao inicio()
	{
		const real DESCONTO = 0.1

		real preco
		real valorfinal

		escreva("digite o valor do produto:")
		leia(preco)

		valorfinal = preco - (preco * DESCONTO)

		escreva("valor com descontin do bao: R$",valorfinal)

		
	}
}
